---
import { tinaField } from '@tinacms/astro/tina-field';
import type { Home } from '../../lib/data';
import CtaButton from '../CtaButton.astro';

interface Props {
  data: NonNullable<Home['hero']>;
  email?: string | null;
}

const { data, email } = Astro.props;
---

<section
  class="relative min-h-[500px] bg-cover"
  style={data.image ? `background-image: url('${data.image}')` : undefined}
  data-tina-field={tinaField(data, 'image')}
>
  <div class="relative flex items-start justify-start p-16 pt-16 pr-24 pl-4 xl:p-16">
    <div class="rounded-lg bg-white/70 p-8 text-black xl:w-2/6 xl:p-20">
      <h1 class="mb-2 text-lg font-bold uppercase xl:text-4xl" data-tina-field={tinaField(data, 'heading')}>
        {data.heading}
      </h1>
      <p class="mb-2 text-sm font-semibold xl:text-xl" data-tina-field={tinaField(data, 'subheading')}>
        {data.subheading}
      </p>
      {data.ctaLabel && (
        <CtaButton email={email} class="mt-4 rounded-sm px-4 py-2 text-xs" data-tina-field={tinaField(data, 'ctaLabel')}>
          {data.ctaLabel}
        </CtaButton>
      )}
    </div>
  </div>
</section>
