---
import { tinaField } from '@tinacms/astro/tina-field';
import type { Home } from '../../lib/data';
import CtaButton from '../CtaButton.astro';

interface Props {
  data: NonNullable<Home['hero']>;
}

const { data } = Astro.props;
const heroSrcSet = data.image && process.env.NETLIFY
  ? [640, 960, 1280, 1600]
      .map((width) => `/.netlify/images?url=${encodeURIComponent(data.image!)}&w=${width}&q=82 ${width}w`)
      .join(', ')
  : undefined;
---

<section class="relative isolate flex min-h-[560px] items-start overflow-hidden sm:min-h-[600px] sm:items-end lg:min-h-[650px] xl:min-h-[700px]">
  {data.image && (
    <img
      src={data.image}
      srcset={heroSrcSet}
      sizes="100vw"
      alt=""
      width="1600"
      height="1600"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-bottom xl:origin-bottom-left xl:scale-[1.08]"
      data-tina-field={tinaField(data, 'image')}
    />
  )}
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/55 via-black/5 to-black/10" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-screen-2xl px-4 pt-5 pb-5 sm:pt-0 sm:pb-8 xl:px-6 xl:pb-14">
    <div class="max-w-lg border border-white/70 bg-white/60 p-6 text-ink shadow-lg shadow-black/10 backdrop-blur-[2px] sm:p-7 xl:p-8">
      {data.trustLabel && (
        <p class="mb-6 border-l-2 border-black pl-3 text-xs font-bold tracking-[0.12em] text-gray-700 uppercase" data-tina-field={tinaField(data, 'trustLabel')}>
          {data.trustLabel}
        </p>
      )}
      <h1
        class="mb-4 text-4xl leading-[0.98] font-extrabold tracking-[-0.055em] text-balance sm:text-5xl"
        data-tina-field={tinaField(data, 'heading')}
      >
        {data.heading}
      </h1>
      <p class="max-w-xl text-base leading-relaxed text-gray-700 sm:text-lg xl:text-xl" data-tina-field={tinaField(data, 'subheading')}>
        {data.subheading}
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        {data.ctaLabel && (
          <CtaButton href="#anfrage" data-tina-field={tinaField(data, 'ctaLabel')}>
            {data.ctaLabel}
          </CtaButton>
        )}
        {data.secondaryCtaLabel && (
          <a href="#projekte" class="inline-flex min-h-12 items-center px-5 text-sm font-bold text-ink underline decoration-2 underline-offset-4" data-tina-field={tinaField(data, 'secondaryCtaLabel')}>
            {data.secondaryCtaLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
