---
import { tinaField } from '@tinacms/astro/tina-field';
import type { Home } from '../../lib/data';
import { compact } from '../../lib/data';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  data: NonNullable<Home['customers']>;
}

const { data } = Astro.props;
const logos = compact(data.logos).filter((logo) => logo.image);

const sizes: Record<string, string> = {
  sm: 'h-14 xl:h-20',
  md: 'h-16 xl:h-24',
  lg: 'h-20 xl:h-28',
};
---

<section class="border-b border-black/8 bg-paper py-16 sm:py-20">
  <div class="mx-auto mb-8 max-w-screen-2xl px-6">
    <SectionHeading section={data} />
  </div>
  <div class="group overflow-hidden border-y border-black/10 bg-white py-4 focus:outline-none" role="region" aria-label="Durchlaufende Auswahl unserer Kundenlogos. Die Animation pausiert bei Fokus oder wenn der Mauszeiger darüber liegt." tabindex="0">
    <div class="flex w-max animate-logo-scroll items-center group-hover:[animation-play-state:paused] group-focus:[animation-play-state:paused] motion-reduce:w-full motion-reduce:animate-none">
      {[false, true].map((duplicate) => (
        <ul
          class:list={[
            'flex items-center motion-reduce:grid motion-reduce:w-full motion-reduce:grid-cols-2 motion-reduce:gap-6 sm:motion-reduce:grid-cols-3 lg:motion-reduce:grid-cols-5',
            duplicate && 'motion-reduce:hidden',
          ]}
          aria-hidden={duplicate ? 'true' : undefined}
        >
          {logos.map((logo) => (
            <li class="grid min-h-28 w-52 shrink-0 place-items-center px-8 motion-reduce:w-auto" data-tina-field={duplicate ? undefined : tinaField(logo)}>
              <img
                src={logo.image}
                alt={duplicate ? '' : logo.name}
                loading="lazy"
                class:list={['max-w-full object-contain grayscale', sizes[logo.size ?? 'md'] ?? sizes.md]}
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
