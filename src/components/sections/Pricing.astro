---
import { tinaField } from '@tinacms/astro/tina-field';
import type { Home } from '../../lib/data';
import { compact } from '../../lib/data';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  data: NonNullable<Home['pricing']>;
}

const { data } = Astro.props;

const euro = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' });

const items = compact(data.items).map((item) => {
  const tiers = compact(item.tiers).sort((a, b) => a.minQuantity - b.minQuantity);
  const fromPrice = item.fromPrice ?? (tiers.length ? Math.min(...tiers.map((t) => t.price)) : null);
  return { item, tiers, fromPrice };
});
---

<section id="preise" class="bg-white px-6 py-20 xl:py-28">
  <div class="mx-auto max-w-screen-2xl">
    <SectionHeading section={data} />
    {data.intro && (
      <p class="mt-5 max-w-3xl text-sm leading-relaxed text-gray-700 lg:text-base" data-tina-field={tinaField(data, 'intro')}>{data.intro}</p>
    )}

  <div class="mt-12 grid border-t border-black/20 md:grid-cols-2 xl:grid-cols-3">
    {items.map(({ item, tiers, fromPrice }) => (
      <article class="flex flex-col border-b border-black/20 p-6 md:border-r md:nth-[2n]:border-r-0 xl:nth-[2n]:border-r xl:nth-[3n]:border-r-0 xl:p-8" data-tina-field={tinaField(item)}>
        {item.image && (
          <img src={item.image} alt="" loading="lazy" class="mb-5 aspect-[4/3] w-full object-cover" data-tina-field={tinaField(item, 'image')} />
        )}
        <h3 class="text-xl font-extrabold xl:text-2xl" data-tina-field={tinaField(item, 'product')}>{item.product}</h3>
        {item.description && (
          <p class="mt-2 text-sm leading-relaxed text-gray-700" data-tina-field={tinaField(item, 'description')}>{item.description}</p>
        )}
        {fromPrice != null && (
          <p class="mt-6 flex flex-wrap items-baseline gap-x-2" data-tina-field={tinaField(item, 'fromPrice')}>
            <span class="text-sm text-gray-600">ab</span>
            <span class="text-3xl font-extrabold xl:text-4xl">{euro.format(fromPrice)}</span>
            {item.unit && <span class="text-sm text-gray-600" data-tina-field={tinaField(item, 'unit')}>{item.unit}</span>}
          </p>
        )}
        {tiers.length > 0 && (
          <table class="mt-6 w-full text-sm" data-tina-field={tinaField(item, 'tiers')}>
            <caption class="sr-only">Staffelpreise {item.product}</caption>
            <thead>
              <tr class="border-b border-gray-300 text-left text-xs uppercase">
                <th scope="col" class="py-2 font-semibold">Menge</th>
                <th scope="col" class="py-2 text-right font-semibold">Preis pro Stück</th>
              </tr>
            </thead>
            <tbody>
              {tiers.map((tier) => (
                <tr class="border-b border-gray-200 last:border-0">
                  <td class="py-2">ab {tier.minQuantity} Stück</td>
                  <td class="py-2 text-right font-semibold tabular-nums">{euro.format(tier.price)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </article>
    ))}
  </div>

  {data.footnote && (
    <p class="mt-6 text-xs leading-relaxed text-gray-600" data-tina-field={tinaField(data, 'footnote')}>{data.footnote}</p>
  )}
  <p class="mt-6 text-sm">
    Größere Mengen oder Sonderwünsche?
    <a
      href="#anfrage"
      class="ml-1 font-semibold underline underline-offset-4"
      data-umami-event="inquiry_cta_click"
      data-umami-event-location="pricing"
    >Individuelles Angebot anfragen</a>
  </p>
  </div>
</section>
