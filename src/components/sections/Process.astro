---
import { tinaField } from '@tinacms/astro/tina-field';
import type { Home } from '../../lib/data';
import { compact } from '../../lib/data';
import SectionHeading from '../SectionHeading.astro';
import CtaButton from '../CtaButton.astro';

interface Props {
  data: NonNullable<Home['process']>;
}

const { data } = Astro.props;
const steps = compact(data.steps);
---

<section id="ablauf" class="bg-soft px-6 py-20 xl:py-28">
  <div class="mx-auto max-w-5xl">
    <div class="mb-14 lg:text-center">
      <SectionHeading section={data} />
    </div>

    <!--
      Timeline: graue Linie mit schwarzer Füllung, die beim Scrollen mitwächst.
      Mobil steht die Linie links, ab lg mittig mit abwechselnden Karten.
    -->
    <div class="relative" data-timeline>
      <div class="absolute top-6 bottom-6 left-6 w-0.5 -translate-x-1/2 bg-black/10 lg:left-1/2" aria-hidden="true">
        <div
          class="h-full w-full origin-top bg-black"
          style="transform: scaleY(var(--timeline-progress, 1))"
        ></div>
      </div>

      <ol class="relative space-y-8 lg:space-y-4">
        {steps.map((step, index) => {
          const right = index % 2 === 1;
          return (
            <li class="relative grid grid-cols-[3rem_1fr] items-start gap-5 lg:grid-cols-[1fr_3rem_1fr] lg:gap-10" data-tina-field={tinaField(step)}>
              <span
                class="relative z-10 grid size-12 place-items-center rounded-full bg-black text-lg font-bold text-white ring-8 ring-soft lg:col-start-2 lg:row-start-1"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <div
                class:list={[
                'border-t border-black/20 bg-white p-6 xl:p-7',
                  right ? 'lg:col-start-3' : 'lg:col-start-1 lg:text-right',
                  'lg:row-start-1',
                ]}
                data-reveal
              >
                <h3 class="mb-2 text-lg font-bold tracking-tight xl:text-xl" data-tina-field={tinaField(step, 'title')}>
                  <span class="sr-only">{index + 1}. </span>{step.title}
                </h3>
                <p class="text-sm leading-relaxed text-gray-600 lg:text-base" data-tina-field={tinaField(step, 'text')}>{step.text}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>

    {data.ctaLabel && (
      <div class="mt-16 flex justify-center" data-reveal>
        <CtaButton
          href="#anfrage"
          class="px-8 text-base"
          data-tina-field={tinaField(data, 'ctaLabel')}
          data-umami-event="inquiry_cta_click"
          data-umami-event-location="process"
        >
          {data.ctaLabel}
        </CtaButton>
      </div>
    )}
  </div>
</section>

<script>
  // Füllt die Timeline-Linie passend zur Scrollposition. Ohne JS oder bei
  // reduzierter Bewegung bleibt sie komplett schwarz.
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  if (timeline && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      const rect = timeline.getBoundingClientRect();
      const anchor = window.innerHeight * 0.6;
      const progress = Math.min(1, Math.max(0, (anchor - rect.top) / rect.height));
      timeline.style.setProperty('--timeline-progress', progress.toFixed(3));
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
