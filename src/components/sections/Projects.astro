---
import { tinaField } from '@tinacms/astro/tina-field';
import type { Home } from '../../lib/data';
import { compact } from '../../lib/data';

interface Props {
  data: NonNullable<Home['projects']>;
}

const { data } = Astro.props;
const images = compact(data.images).filter((img) => img.image);
const srcSet = (src: string) => process.env.NETLIFY
  ? [360, 600, 900]
      .map((width) => `/.netlify/images?url=${encodeURIComponent(src)}&w=${width}&q=82 ${width}w`)
      .join(', ')
  : undefined;
---

<section id="projekte" class="bg-ink px-6 py-20 text-white xl:py-28" data-theme="dark" data-projects-section>
  <div class="mx-auto max-w-screen-2xl">
    <div class="max-w-3xl" data-reveal>
      <p class="mb-3 text-sm font-semibold text-white/65">Aus unserer Werkstatt</p>
      <h2 class="text-3xl leading-[1.08] font-extrabold tracking-[-0.035em] text-balance sm:text-4xl xl:text-5xl" data-tina-field={tinaField(data, 'heading')}>
        {data.heading}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-white/80 xl:text-lg" data-tina-field={tinaField(data, 'text')}>{data.text}</p>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 xl:mt-14" data-reveal>
      {images.map((img, index) => (
        <li
          class:list={[
            'group relative overflow-hidden bg-black',
            index === 0 ? 'col-span-2 row-span-2 aspect-square md:aspect-auto' : 'aspect-square',
          ]}
          data-tina-field={tinaField(img)}
        >
          <img
            src={img.image}
            srcset={srcSet(img.image!)}
            sizes={index === 0 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
            alt={img.alt ?? ''}
            width="750"
            height="750"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          {(img.customer || img.product || img.finish) && (
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent px-4 pt-16 pb-4 md:px-5 md:pb-5" aria-hidden="true">
              {img.customer && <p class="text-sm font-extrabold sm:text-base">{img.customer}</p>}
              <p class="mt-1 text-xs text-white/75">
                {[img.product, img.finish].filter(Boolean).join(' · ')}
              </p>
            </div>
          )}
        </li>
      ))}
    </ul>
    <div class="mt-10 flex flex-col gap-4 border-t border-white/25 py-8 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <p class="max-w-xl text-lg font-bold text-balance">Interesse an einem eigenen Projekt?</p>
      <a
        href="#anfrage"
        class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-sm bg-white px-6 text-sm font-bold text-black hover:bg-gray-200"
        data-umami-event="inquiry_cta_click"
        data-umami-event-location="projects"
      >Unverbindlich anfragen</a>
    </div>
  </div>
</section>

<script>
  const projectsSection = document.querySelector<HTMLElement>('[data-projects-section]');
  if (projectsSection) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        const analyticsWindow = window as Window & { umami?: { track: (eventName: string) => void } };
        const trackView = () => analyticsWindow.umami?.track('projects_view');
        if (document.readyState === 'complete') trackView();
        else window.addEventListener('load', trackView, { once: true });
        observer.disconnect();
      },
      { threshold: 0.5 },
    );
    observer.observe(projectsSection);
  }
</script>
