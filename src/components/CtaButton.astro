---
interface Props {
  email?: string | null;
  href?: string;
  variant?: 'primary' | 'dark';
  class?: string;
  [key: string]: unknown;
}

const { email, href, variant = 'primary', class: className, ...rest } = Astro.props;
const destination = href ?? (email ? `mailto:${email}` : '#anfrage');
---

<a
  href={destination}
  class:list={[
    'group inline-flex min-h-12 items-center gap-2 rounded-sm px-6 text-sm font-bold text-white',
    'transition-colors duration-200',
    variant === 'primary' ? 'bg-accent hover:bg-accent-dark' : 'bg-ink hover:bg-black',
    className,
  ]}
  {...rest}
>
  <slot />
  <svg
    class="size-4 transition-transform duration-200 group-hover:translate-x-1"
    viewBox="0 0 16 16"
    fill="none"
    aria-hidden="true"
  >
    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
