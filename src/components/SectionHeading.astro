---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  section: { kicker?: string | null; heading?: string | null };
}

const { section } = Astro.props;
---

<div data-reveal>
  {section.kicker && (
    <p class="mb-3 text-sm font-semibold text-gray-600" data-tina-field={tinaField(section, 'kicker')}>{section.kicker}</p>
  )}
  <h2 class="max-w-3xl text-3xl leading-[1.08] font-extrabold tracking-[-0.035em] text-balance sm:text-4xl xl:text-5xl" data-tina-field={tinaField(section, 'heading')}>{section.heading}</h2>
</div>
