---
import { tinaField } from '@tinacms/astro/tina-field';
import type { Settings } from '../lib/data';

interface Props {
  settings?: Settings | null;
}

const { settings } = Astro.props;

// Sprungziele auf der Startseite. Links zu ausgeblendeten Sektionen
// entfernt das Script unten automatisch.
const nav = [
  { label: 'Leistungen', href: '#leistungen' },
  { label: 'Kundenstimmen', href: '#stimmen' },
  { label: 'Projekte', href: '#projekte' },
  { label: 'Preise', href: '#preise' },
  { label: 'Ablauf', href: '#ablauf' },
  { label: 'FAQ', href: '#faq' },
];
---

<div class="relative mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-3 px-4 py-2 xl:px-6" data-header-inner>
  <a href="/" class="shrink-0 rounded-sm" aria-label="ROOTED MERCH – zur Startseite">
    {settings?.logo && (
      <img
        src={settings.logo}
        alt={settings.footer?.company ?? 'Rooted Merch'}
        width="480"
        height="202"
        class="h-auto w-24 sm:w-28"
        data-tina-field={tinaField(settings, 'logo')}
      />
    )}
  </a>

  <nav aria-label="Hauptnavigation" class="hidden lg:block">
    <ul class="flex items-center gap-1">
      {nav.map((item) => (
        <li data-nav-target={item.href}>
          <a
            href={item.href}
            class="relative inline-flex min-h-11 items-center px-3 text-sm font-semibold text-gray-700 transition-colors after:absolute after:right-3 after:bottom-1.5 after:left-3 after:h-px after:origin-left after:scale-x-0 after:bg-black after:transition-transform hover:text-black hover:after:scale-x-100"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="flex items-center gap-2">
    <a
      href="#anfrage"
      class="hidden min-h-11 shrink-0 items-center gap-2 rounded-sm bg-ink px-5 text-sm font-bold text-white transition-colors hover:bg-black sm:inline-flex"
      data-umami-event="inquiry_cta_click"
      data-umami-event-location="header_desktop"
    >
      Anfragen
      <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <button
      type="button"
      class="inline-flex size-11 items-center justify-center rounded-sm border border-black/20 bg-white text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      aria-label="Menü öffnen"
      data-menu-toggle
    >
      <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true" data-menu-open-icon>
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <svg class="hidden size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true" data-menu-close-icon>
        <path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <button
    type="button"
    class="fixed inset-x-0 top-16 h-[calc(100svh-4rem)] cursor-default bg-black/35 backdrop-blur-[1px] lg:hidden"
    aria-label="Menü schließen"
    tabindex="-1"
    hidden
    data-menu-backdrop
  ></button>

  <nav
    id="mobile-navigation"
    aria-label="Mobile Hauptnavigation"
    class="fixed inset-x-0 top-16 max-h-[calc(100svh-4rem)] overflow-y-auto border-t border-black/15 bg-white shadow-xl shadow-black/10 lg:hidden"
    hidden
    data-mobile-nav
  >
    <ul class="mx-auto max-w-2xl px-5 pt-3">
      {nav.map((item, index) => (
        <li data-nav-target={item.href}>
          <a href={item.href} class="flex min-h-14 items-center justify-between gap-5 border-b border-black/10 px-1 text-lg font-extrabold tracking-tight hover:bg-soft">
            <span class="flex items-baseline gap-4">
              <span class="text-xs font-semibold tabular-nums text-gray-500">0{index + 1}</span>
              {item.label}
            </span>
            <svg class="size-4 text-gray-500" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
    <div class="mx-auto max-w-2xl px-5 pt-6 pb-8">
      <a
        href="#anfrage"
        class="flex min-h-12 items-center justify-between rounded-sm bg-ink px-5 font-bold text-white hover:bg-black"
        data-umami-event="inquiry_cta_click"
        data-umami-event-location="header_mobile"
      >
        Projekt anfragen
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      {settings?.email && (
        <a
          href={`mailto:${settings.email}`}
          class="mt-3 flex min-h-11 items-center justify-center text-sm font-semibold text-gray-700 underline underline-offset-4"
          data-tina-field={tinaField(settings, 'email')}
          data-umami-event="email_click"
          data-umami-event-location="header_mobile"
        >
          Direkt per E-Mail: {settings.email}
        </a>
      )}
    </div>
  </nav>
</div>

<script>
  const headerInner = document.querySelector<HTMLElement>('[data-header-inner]');
  headerInner?.querySelectorAll<HTMLElement>('[data-nav-target]').forEach((item) => {
    if (!document.querySelector(item.dataset.navTarget!)) item.remove();
  });

  const toggle = headerInner?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileNav = headerInner?.querySelector<HTMLElement>('[data-mobile-nav]');
  const backdrop = headerInner?.querySelector<HTMLButtonElement>('[data-menu-backdrop]');
  const openIcon = toggle?.querySelector<HTMLElement>('[data-menu-open-icon]');
  const closeIcon = toggle?.querySelector<HTMLElement>('[data-menu-close-icon]');

  const closeMenu = (restoreFocus = false) => {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Menü öffnen');
    mobileNav.hidden = true;
    if (backdrop) backdrop.hidden = true;
    document.documentElement.classList.remove('overflow-hidden');
    openIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    if (restoreFocus) toggle.focus();
  };

  toggle?.addEventListener('click', () => {
    if (!mobileNav) return;
    const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(willOpen));
    toggle.setAttribute('aria-label', willOpen ? 'Menü schließen' : 'Menü öffnen');
    mobileNav.hidden = !willOpen;
    if (backdrop) backdrop.hidden = !willOpen;
    document.documentElement.classList.toggle('overflow-hidden', willOpen);
    openIcon?.classList.toggle('hidden', willOpen);
    closeIcon?.classList.toggle('hidden', !willOpen);
  });
  mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
  backdrop?.addEventListener('click', () => closeMenu(true));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') closeMenu(true);
  });
  matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
    if (event.matches) closeMenu();
  });
</script>
