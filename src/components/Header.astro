---
import { tinaField } from '@tinacms/astro/tina-field';
import type { Settings } from '../lib/data';

interface Props {
  settings?: Settings | null;
}

const { settings } = Astro.props;
---

{settings?.logo && (
  <div data-tina-field={tinaField(settings, 'logo')}>
    <img
      src={settings.logo}
      alt={settings.footer?.company ?? 'Rooted Merch'}
      width="480"
      height="202"
      class="mx-auto my-4 h-auto w-28 xl:w-40"
    />
  </div>
)}
