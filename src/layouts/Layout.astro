---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/data';
import { islands } from '../lib/islands';
import '../styles/global.css';

const settings = (await getSettings()).data?.settings;
const title = settings?.seo?.title ?? 'ROOTED - MERCH';
const description = settings?.seo?.description ?? '';
const ogImage = new URL(settings?.logo ?? '/favicon.png', Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@300..800&display=swap" rel="stylesheet" />
    <script is:inline>
      // Scroll-Animationen nur auf der echten Seite – nicht im Tina-Editor
      // (iframe) und nicht bei reduzierter Bewegung.
      if (window.self === window.top && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
  </head>
  <body class="overflow-x-hidden antialiased [&>header]:sticky [&>header]:top-0 [&>header]:z-40 [&>header]:border-b [&>header]:border-black/8 [&>header]:bg-paper/95 [&>header]:backdrop-blur-md">
    <a href="#main-content" class="skip-link">Zum Inhalt</a>
    <TinaIsland name="header" wrapper={islands.header.wrapper}>
      <Header settings={settings} />
    </TinaIsland>
    <slot />
    <TinaIsland name="footer" wrapper={islands.footer.wrapper}>
      <Footer settings={settings} />
    </TinaIsland>
    <script>
      if (document.documentElement.classList.contains('reveal-ready')) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
