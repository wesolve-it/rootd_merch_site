# Tina Cloud (app.tina.io → Projekt → Overview / Tokens)
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Anfrageformular: verifizierte Absenderadresse und Zielpostfach
RESEND_API_KEY=
CONTACT_FROM_EMAIL=ROOTED MERCH <anfrage@rooted-merch.de>
CONTACT_TO_EMAIL=kontakt@rootd.de

# Umami Analytics (Umami → Websites → Edit → Tracking code)
PUBLIC_UMAMI_WEBSITE_ID=dfcf2f59-1abd-4324-be37-c1fe063e60af
# Optional: nur für eine selbst gehostete Umami-Instanz ändern
PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
